{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story layer",
  "description": "A GeoJSON FeatureCollection of story features: places, stops, areas, journeys, mountain glyphs, vignettes, landform label lines, water places or context places. Every feature shares the properties in $defs/properties; $defs/layers adds what each layer requires. crossing.validate checks each file against its layer. See docs/design.md, section 6.",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": false,
  "properties": {
    "type": {"const": "FeatureCollection"},
    "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}}
  },
  "$defs": {
    "episode": {
      "description": "Part and episode within the Part, for example 1-09.",
      "type": "string",
      "pattern": "^[1-4]-(0[1-9]|1[0-4])$"
    },
    "position": {
      "description": "Longitude and latitude in WGS 84.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90}
      ]
    },
    "point": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {"type": {"const": "Point"}, "coordinates": {"$ref": "#/$defs/position"}}
    },
    "lineString": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "LineString"},
        "coordinates": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/position"}}
      }
    },
    "polygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "Polygon"},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/position"}}
        }
      }
    },
    "multiPolygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "MultiPolygon"},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/position"}}}
        }
      }
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "Feature"},
        "geometry": {"oneOf": [{"$ref": "#/$defs/point"}, {"$ref": "#/$defs/lineString"}, {"$ref": "#/$defs/polygon"}, {"$ref": "#/$defs/multiPolygon"}]},
        "properties": {"$ref": "#/$defs/properties"}
      }
    },
    "properties": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "part",
        "first_seen",
        "certainty",
        "method",
        "source",
        "source_licence",
        "note_safe"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "name_in_text": {
          "type": ["string", "null"],
          "description": "Places: the book's own spellings where they differ from name, separated by semicolons."
        },
        "kind": {
          "enum": [
            "abandoned",
            "camp",
            "canyon",
            "cemetery",
            "church",
            "city",
            "corral",
            "county",
            "crossing",
            "customs",
            "flat",
            "inferred-area",
            "lake",
            "locale",
            "mesa",
            "military",
            "mine",
            "pass",
            "peak",
            "plain",
            "plateau",
            "post-office",
            "railway",
            "ranch",
            "range",
            "region",
            "river",
            "route-segment",
            "ruin",
            "sawmill",
            "school",
            "sightline",
            "spring",
            "station",
            "stop",
            "stream",
            "summit",
            "tank",
            "town",
            "tunnel",
            "valley",
            "vignette",
            "vignette-leader",
            "well",
            "windmill"
          ],
          "description": "What the feature is. Each layer allows only its own kinds (see $defs/layers)."
        },
        "role": {
          "enum": ["stop", "passing", "tale", "context", null],
          "description": "context: a real town the book never names, shown at every reading position so the map is not empty."
        },
        "characters": {"type": "array", "items": {"enum": ["billy", "boyd", "wolf", "girl"]}},
        "journey": {"type": ["string", "null"], "pattern": "^J[1-7]$"},
        "sequence": {"type": ["integer", "null"], "minimum": 1},
        "place_ref": {
          "type": ["string", "null"],
          "description": "For a stop: the id of the place it stands for. For a vignette: the id of the stop or place it stands for."
        },
        "part": {"type": "integer", "minimum": 1, "maximum": 4},
        "episode": {"oneOf": [{"$ref": "#/$defs/episode"}, {"type": "null"}]},
        "first_seen": {"$ref": "#/$defs/episode"},
        "pages": {"type": "array", "items": {"type": "string"}},
        "certainty": {"enum": ["located", "approximate", "inferred", "reported"]},
        "travel": {
          "enum": ["foot", "truck", "car", "bus", "train", "reported", null],
          "description": "Route segments: how the leg was travelled. Null for horseback (on J1, the wolf on foot); reported where the book only tells of the leg in summary or through someone else's account."
        },
        "uncertainty_m": {"type": ["number", "null"], "minimum": 0},
        "method": {
          "enum": ["gazetteer", "computed", "hand-drawn", "narrated-path", "modeled", "schematic", "generated"]
        },
        "source": {"type": "string", "minLength": 1},
        "source_id": {"type": ["string", "null"]},
        "source_licence": {"type": "string", "minLength": 1},
        "note_safe": {"type": "string"},
        "note_full": {"type": ["string", "null"]},
        "reasoning": {"type": ["string", "null"]},
        "outline_rule": {
          "type": ["string", "null"],
          "description": "Inferred areas: how the outline was drawn. A draft is the stop's circle (uncertainty_m about the pin) cut by a rule to the ground its reasoning describes (crossing.area_drafts, decision 0020); null for a plain circle."
        },
        "drawn": {
          "type": "string",
          "description": "Route segments: how the line was drawn (traced on a named road or river, computed as a least-cost path, or drawn as a curve), in words for the reader (decision 0032)."
        },
        "cost_model": {
          "type": "string",
          "description": "Route segments with method modeled: the least-cost model version that drew the line (crossing.least_cost, decision 0021)."
        },
        "straight_road": {
          "type": "boolean",
          "description": "Inferred areas: the outline follows a straight line between towns, standing in for an old road no source maps yet."
        },
        "historical": {
          "type": "boolean",
          "description": "Context places: the gazetteer names the feature \"(historical)\", that is gone or no longer in use; the name is given without it."
        },
        "photo_ids": {"type": "array", "items": {"type": "string"}},
        "vignette": {"type": ["string", "null"], "description": "Vignettes: the drawing's name in the map sprite."},
        "stands_for": {"type": "string", "description": "Vignettes: what the drawing stands for in the book."},
        "label": {"type": "string", "description": "Vignettes: the short caption drawn under the drawing."},
        "side": {"enum": ["n", "ne", "e", "se", "s", "sw", "w", "nw"], "description": "Vignettes: the side of the point the drawing is drawn on, beside the pin rather than on it."},
        "credit": {"type": "string", "description": "Vignettes: how the drawing was made and from what sources, with their licences."},
        "min_zoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "description": "Vignettes: the first zoom at which the drawing may show; it shows at every zoom above it."
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "description": "Vignettes: 1 wins a collision over 2, and 2 over 3."
        },
        "elevation_m": {"type": "number", "description": "Mountain glyphs: summit elevation."},
        "prominence_m": {
          "type": ["number", "null"],
          "description": "Mountain glyphs: topographic prominence; null where the key col lies outside the DEM. For a pass, the prominence of the summit whose key col it is."
        },
        "size": {"enum": ["small", "medium", "large"], "description": "Mountain glyphs: size class from prominence."},
        "glyph": {"type": "integer", "minimum": 1, "description": "Mountain glyphs: which drawn shape."},
        "flip": {"type": "boolean"},
        "glyph_scale": {"type": "number"},
        "glyph_rotate": {"type": "number"},
        "name_code": {
          "type": ["string", "null"],
          "description": "Mountain glyphs: the matched name's GeoNames code or GNIS class (gnis:<class>)."
        },
        "landform": {
          "enum": ["peak", "dome", "mesa", "butte", "cone", "ridge", "pass"],
          "description": "Mountain glyphs: which glyph family, from crossing.landforms."
        },
        "landform_source": {
          "enum": ["name", "dem", "default"],
          "description": "Mountain glyphs: the evidence that gave the landform the most points."
        },
        "name_source": {
          "type": "string",
          "pattern": "^(gnis|geonames|gmba|wikidata|this-site):.+$",
          "description": "Landforms: the gazetteer record the name and anchor point come from, as source:id."
        },
        "axis": {
          "enum": ["gmba", "gnis", "dem"],
          "description": "Landforms: how the line was found: the long axis of the GMBA outline, a GNIS valley's mouth and head, or the long axis of the ground around the point in the Copernicus DEM (decision 0020)."
        },
        "elongation": {
          "type": ["number", "null"],
          "minimum": 1,
          "description": "Landforms: how much longer than wide the landform is (1 for round); null for GNIS valleys."
        },
        "len_m": {"type": "integer", "minimum": 0, "description": "Landforms: the label line's length in metres."},
        "mpp0": {
          "type": "integer",
          "minimum": 0,
          "description": "Landforms: metres per pixel at zoom 0 (256 px tiles) at the line's middle, for spacing the letters to fill the line."
        }
      }
    },
    "layers": {
      "places": {
        "description": "Places the book names, and context towns.",
        "properties": {
          "features": {
            "items": {
              "properties": {
                "geometry": {"$ref": "#/$defs/point"},
                "properties": {
                  "required": ["role", "characters", "journey"],
                  "properties": {
                    "kind": {
                      "enum": [
                        "range",
                        "stream",
                        "valley",
                        "spring",
                        "locale",
                        "town",
                        "city",
                        "county",
                        "pass",
                        "summit",
                        "canyon",
                        "plain",
                        "ruin",
                        "ranch",
                        "river",
                        "crossing",
                        "military"
                      ]
                    },
                    "role": {"enum": ["stop", "passing", "tale", "context"]}
                  }
                }
              }
            }
          }
        }
      },
      "stops": {
        "description": "The stops of each journey, in order.",
        "properties": {
          "features": {
            "items": {
              "properties": {
                "geometry": {"$ref": "#/$defs/point"},
                "properties": {
                  "required": ["journey", "sequence", "place_ref", "uncertainty_m", "characters"],
                  "properties": {
                    "kind": {"enum": ["stop"]},
                    "journey": {"type": "string"},
                    "sequence": {"type": "integer"}
                  }
                }
              }
            }
          }
        }
      },
      "areas": {
        "description": "Inferred areas around uncertain stops, and named regions.",
        "properties": {
          "features": {
            "items": {
              "properties": {
                "geometry": {"oneOf": [{"$ref": "#/$defs/polygon"}, {"$ref": "#/$defs/multiPolygon"}]},
                "properties": {
                  "required": ["journey", "place_ref", "uncertainty_m"],
                  "properties": {"kind": {"enum": ["inferred-area", "region"]}}
                }
              }
            }
          }
        }
      },
      "journeys": {
        "description": "Route segments between consecutive stops, and the false-dawn sightline.",
        "properties": {
          "features": {
            "items": {
              "properties": {
                "geometry": {"$ref": "#/$defs/lineString"},
                "properties": {
                  "required": ["journey", "sequence", "travel", "characters"],
                  "properties": {"kind": {"enum": ["route-segment", "sightline"]}, "journey": {"type": "string"}}
                }
              }
            }
          }
        }
      },
      "mountain_glyphs": {
        "description": "Summits and passes drawn as glyphs. landform is added by crossing.landforms after crossing.peaks.",
        "properties": {
          "features": {
            "items": {
              "properties": {
                "geometry": {"$ref": "#/$defs/point"},
                "properties": {
                  "required": [
                    "elevation_m",
                    "prominence_m",
                    "size",
                    "glyph",
                    "flip",
                    "glyph_scale",
                    "glyph_rotate",
                    "name_code",
                    "landform",
                    "landform_source"
                  ],
                  "properties": {"kind": {"enum": ["peak", "pass"]}}
                }
              }
            }
          }
        }
      },
      "landforms": {
        "description": "A label line along each range, valley, plain, mesa and plateau, for its name in spaced capitals (crossing.landform_axes).",
        "properties": {
          "features": {
            "items": {
              "properties": {
                "geometry": {"$ref": "#/$defs/lineString"},
                "properties": {
                  "required": ["place_ref", "name_source", "axis", "elongation", "len_m", "mpp0"],
                  "properties": {"kind": {"enum": ["range", "valley", "plain", "mesa", "plateau"]}}
                }
              }
            }
          }
        }
      },
      "water_places": {
        "description": "Springs, wells, tanks, ranches and stations along the journeys, from GNIS and GeoNames, with the book's own springs and ranches (crossing.water_places).",
        "properties": {
          "features": {
            "items": {
              "properties": {
                "geometry": {"$ref": "#/$defs/point"},
                "properties": {
                  "required": ["source_id", "place_ref"],
                  "properties": {"kind": {"enum": ["spring", "well", "tank", "ranch", "station"]}}
                }
              }
            }
          }
        }
      },
      "context_places": {
        "description": "Forts, ghost towns, mines, sawmills, churches, cemeteries, schools, post offices, corrals, named wells, dry lakes and flats along the journeys, from GNIS (with its national file of 2021) and GeoNames (crossing.context_places).",
        "properties": {
          "features": {
            "items": {
              "properties": {
                "geometry": {"$ref": "#/$defs/point"},
                "properties": {
                  "required": ["source_id", "historical"],
                  "properties": {"kind": {"enum": ["abandoned", "camp", "cemetery", "church", "corral", "customs", "flat", "lake", "military", "mine", "post-office", "railway", "ranch", "ruin", "sawmill", "school", "station", "tunnel", "well", "windmill"]}}
                }
              }
            }
          }
        }
      },
      "vignettes": {
        "description": "Anchors for the decorative drawings, and their leaders.",
        "properties": {
          "features": {
            "items": {
              "properties": {
                "geometry": {"oneOf": [{"$ref": "#/$defs/point"}, {"$ref": "#/$defs/lineString"}]},
                "properties": {
                  "required": ["place_ref"],
                  "properties": {"kind": {"enum": ["vignette", "vignette-leader"]}},
                  "if": {"properties": {"kind": {"const": "vignette"}}},
                  "then": {"required": ["vignette", "stands_for", "min_zoom", "priority"]}
                }
              }
            }
          }
        }
      }
    }
  }
}
