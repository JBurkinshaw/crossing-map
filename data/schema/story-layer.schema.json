{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story layer",
  "description": "A GeoJSON FeatureCollection of story features (places, areas, journeys, stops, conversations, vignettes). Every feature shares these properties. See docs/plan.md, section 6.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
  },
  "$defs": {
    "episode": {
      "description": "Part and episode within the Part, for example 1-09.",
      "type": "string",
      "pattern": "^[1-4]-(0[1-9]|1[0-4])$"
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "enum": ["Point", "LineString", "MultiLineString", "Polygon", "MultiPolygon"] }
          }
        },
        "properties": { "$ref": "#/$defs/properties" }
      }
    },
    "properties": {
      "type": "object",
      "required": ["id", "name", "kind", "part", "first_seen", "certainty", "method", "source", "source_licence", "note_safe"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "name_in_text": { "type": ["string", "null"] },
        "kind": { "type": "string", "minLength": 1 },
        "role": { "enum": ["stop", "passing", "tale", "context", null], "description": "context: a real town the book never names, shown at every reading position so the map is not empty." },
        "characters": { "type": "array", "items": { "enum": ["billy", "boyd", "wolf", "girl"] } },
        "journey": { "type": ["string", "null"], "pattern": "^J[1-7]$" },
        "sequence": { "type": ["integer", "null"], "minimum": 1 },
        "place_ref": { "type": ["string", "null"], "description": "For a stop: the id of the place it stands for." },
        "part": { "type": "integer", "minimum": 1, "maximum": 4 },
        "episode": { "oneOf": [{ "$ref": "#/$defs/episode" }, { "type": "null" }] },
        "first_seen": { "$ref": "#/$defs/episode" },
        "pages": { "type": "array", "items": { "type": "string" } },
        "certainty": { "enum": ["located", "approximate", "inferred", "reported"] },
        "travel": { "enum": ["foot", "truck", "car", "bus", "train", "reported", null], "description": "Route segments: how the leg was travelled. Null for horseback (on J1, the wolf on foot); reported where the book only tells of the leg in summary or through someone else's account." },
        "uncertainty_m": {"type": ["number", "null"], "minimum": 0 },
        "method": { "enum": ["gazetteer", "computed", "hand-drawn", "narrated-path", "modeled", "schematic", "generated"] },
        "source": { "type": "string", "minLength": 1 },
        "source_id": { "type": ["string", "null"] },
        "source_licence": { "type": "string", "minLength": 1 },
        "note_safe": { "type": "string" },
        "note_full": { "type": ["string", "null"] },
        "reasoning": { "type": ["string", "null"] },
        "photo_ids": { "type": "array", "items": { "type": "string" } },
        "vignette": { "type": ["string", "null"] },
        "elevation_m": { "type": "number", "description": "Mountain glyphs: summit elevation." },
        "prominence_m": { "type": ["number", "null"], "description": "Mountain glyphs: topographic prominence; null where the key col lies outside the DEM. For a pass, the prominence of the summit whose key col it is." },
        "size": { "enum": ["small", "medium", "large"], "description": "Mountain glyphs: size class from prominence." },
        "glyph": { "type": "integer", "minimum": 1, "description": "Mountain glyphs: which drawn shape." },
        "flip": { "type": "boolean" },
        "glyph_scale": { "type": "number" },
        "glyph_rotate": { "type": "number" },
        "name_code": { "type": ["string", "null"], "description": "Mountain glyphs: the matched name's GeoNames code or GNIS class (gnis:<class>)." },
        "landform": { "enum": ["peak", "dome", "mesa", "butte", "cone", "ridge", "pass"], "description": "Mountain glyphs: which glyph family, from crossing.landforms." },
        "landform_source": { "enum": ["name", "dem", "default"], "description": "Mountain glyphs: the evidence that gave the landform the most points." }
      }
    }
  }
}
