{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elsewhere",
  "description": "Places the book names that lie outside the story box: listed in the panel, not mapped.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "first_seen", "role"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
      "name": {"type": "string", "minLength": 1},
      "first_seen": {"type": "string", "pattern": "^[1-4]-(0[1-9]|1[0-4])$"},
      "role": {"enum": ["stop", "passing", "tale"]}
    }
  }
}
